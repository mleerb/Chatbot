{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose run --rm --no-deps --volume \"$PWD/tests:/app/tests:ro\" app python -m unittest discover -s tests)",
      "Bash(npm --prefix frontend run typecheck)",
      "Bash(npm --prefix frontend run build)",
      "Bash(npm --prefix frontend test)",
      "Bash(curl --fail --silent --output /dev/null http://127.0.0.1:18080/:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(docker compose down:*)",
      "Bash(docker compose up:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.docker.env)",
      "Read(./documents/**)",
      "Edit(./.env)",
      "Edit(./.docker.env)",
      "Bash(cat .env:*)",
      "Bash(cat .docker.env:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose down --volumes:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
